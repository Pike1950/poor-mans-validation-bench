<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>PMVB Report - {{ run_id }}</title>
<style>
body { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; max-width: 1100px; margin: 2rem auto; padding: 0 2rem; color: #d4d4d4; background: #1a1a2e; line-height: 1.6; }
h1 { color: #f0f0f0; border-bottom: 2px solid #e94560; padding-bottom: 0.5rem; }
h2 { color: #60a5fa; margin-top: 2rem; }
.summary { background: #16213e; padding: 1rem 1.5rem; border-radius: 8px; border-left: 4px solid #60a5fa; }
.chart { margin: 1.5rem 0; padding: 1rem; background: #16213e; border-radius: 8px; }
.chart img { max-width: 100%; height: auto; }
.meta { color: #888; font-size: 0.9rem; }
table { border-collapse: collapse; width: 100%; font-size: 0.85rem; margin-top: 0.5rem; }
th, td { border: 1px solid #333; padding: 0.4rem 0.6rem; text-align: left; }
th { background: #0f3460; color: #f0f0f0; }
td { background: #16213e; }
code { background: #0d1117; color: #fbbf24; padding: 0.15rem 0.4rem; border-radius: 3px; font-size: 0.9em; }
</style>
</head>
<body>

<h1>PMVB Report</h1>

<div class="summary">
  <p><strong>Run ID:</strong> <code>{{ run_id }}</code></p>
  <p><strong>Records:</strong> {{ record_count }}</p>
  <p><strong>Charts:</strong> {{ chart_count }}</p>
</div>

{% if charts %}
{% for chart in charts %}
<div class="chart">
  <h2>{{ chart.title }}</h2>
  <p class="meta">
    instrument={{ chart.instrument }} &middot;
    channel={{ chart.channel }} &middot;
    measurement_type={{ chart.measurement_type }} &middot;
    points={{ chart.count }}
  </p>
  {% if chart.data_uri %}<img src="{{ chart.data_uri }}" alt="{{ chart.title }}">{% endif %}
  <table>
    <thead><tr><th>time</th><th>value</th></tr></thead>
    <tbody>
    {% for r in chart.records %}<tr><td>{{ r.time }}</td><td>{{ r.value }}</td></tr>{% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}
{% else %}
<p><em>No records found for run_id <code>{{ run_id }}</code>.</em></p>
{% endif %}

</body>
</html>
